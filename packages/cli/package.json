{
  "name": "vigiacode",
  "version": "0.1.0",
  "description": "VigiaCode — rastreador de amarrações front/back/banco, roadmap vivo e servidor MCP para projetos desenvolvidos com agentes de IA.",
  "keywords": [
    "ai",
    "agents",
    "architecture",
    "bindings",
    "code-review",
    "developer-tools",
    "drizzle",
    "fastify",
    "mcp",
    "model-context-protocol",
    "prisma",
    "roadmap",
    "sqlite",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josejuniorctis-byte/vigiacode.git"
  },
  "bugs": {
    "url": "https://github.com/josejuniorctis-byte/vigiacode/issues"
  },
  "homepage": "https://github.com/josejuniorctis-byte/vigiacode#readme",
  "bin": {
    "vigiacode": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/index.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.0.0",
    "chokidar": "^4.0.0",
    "commander": "^14.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "simple-git": "^3.27.0",
    "typescript": "^5.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "vitest": "^3.0.0"
  }
}
