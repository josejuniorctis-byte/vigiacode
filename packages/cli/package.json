{
  "name": "vigiacode",
  "version": "0.1.0",
  "description": "CLI do VigiaCode — vigia de mudanças, diffs e resumos para projetos com agentes de IA.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vigiacode": "dist/index.js",
    "codeanchor": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/index.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^12.0.0",
    "chokidar": "^4.0.0",
    "commander": "^14.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "simple-git": "^3.27.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "vitest": "^3.0.0"
  }
}
