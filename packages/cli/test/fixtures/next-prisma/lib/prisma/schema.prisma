datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int     @id @default(autoincrement())
  name       String
  email      String
  role       String
  legacyCode String?

  @@map("users")
}

model Order {
  id    Int     @id @default(autoincrement())
  total Decimal

  @@map("orders")
}
